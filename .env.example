# RetailInsight AI — Environment Variables
# Copy this file to .env.local and fill in your Gemini API key.
# Get a free key at: https://aistudio.google.com/app/apikey

# Optional: pre-fill the Gemini API key so users don't have to enter it manually.
# If left empty, users can enter the key directly in the AI Analyst panel.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: configure Gemini model (defaults to gemini-3.8-flash)
VITE_GEMINI_MODEL=gemini-3.8-flash
